<%- include('../layouts/header') %>

<div class="max-w-7xl mx-auto space-y-6">
  <div>
    <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-white flex items-center space-x-2">
      <i data-lucide="check-square" class="w-7 h-7 text-indigo-400"></i>
      <span>All Tasks</span>
    </h1>
    <p class="mt-1 text-sm text-gray-400">
      Global view across all projects in <%= workspace.name %> (Rendered with EJS).
    </p>
  </div>

  <!-- Filter Bar -->
  <div class="glass-panel p-4 rounded-2xl flex flex-col md:flex-row gap-3 items-center justify-between">
    <div class="relative w-full md:w-80">
      <i data-lucide="search" class="w-4 h-4 text-gray-500 absolute left-3 top-3"></i>
      <input
        id="taskSearchInput"
        type="text"
        oninput="filterTasks()"
        placeholder="Search tasks..."
        class="w-full pl-9 pr-3 py-2 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-gray-500 text-xs focus:outline-none focus:border-indigo-500"
      />
    </div>

    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
      <!-- Status Filter -->
      <select
        id="taskStatusFilter"
        onchange="filterTasks()"
        class="px-3 py-2 rounded-xl bg-gray-900 border border-white/10 text-white text-xs focus:outline-none focus:border-indigo-500"
      >
        <option value="all">All Statuses</option>
        <option value="backlog">Backlog</option>
        <option value="todo">To Do</option>
        <option value="in_progress">In Progress</option>
        <option value="in_review">In Review</option>
        <option value="done">Done</option>
      </select>

      <!-- Project Filter -->
      <select
        id="taskProjectFilter"
        onchange="filterTasks()"
        class="px-3 py-2 rounded-xl bg-gray-900 border border-white/10 text-white text-xs focus:outline-none focus:border-indigo-500"
      >
        <option value="all">All Projects</option>
        <% projects.forEach(function(p) { %>
          <option value="<%= p.id %>"><%= p.name %></option>
        <% }); %>
      </select>

      <span class="text-xs text-gray-400 ml-auto md:ml-2">
        Showing <strong id="taskCountText" class="text-white"><%= tasks.length %></strong> tasks
      </span>
    </div>
  </div>

  <!-- Tasks Table -->
  <div class="glass-panel rounded-2xl border border-white/5 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-white/[0.02] border-b border-white/5 text-gray-400 font-semibold uppercase tracking-wider text-[10px]">
          <tr>
            <th class="py-3.5 px-4">Task</th>
            <th class="py-3.5 px-4">Project</th>
            <th class="py-3.5 px-4">Status</th>
            <th class="py-3.5 px-4">Priority</th>
            <th class="py-3.5 px-4">Assignee</th>
            <th class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="tasksTbody" class="divide-y divide-white/5 text-gray-300">
          <% if (tasks.length === 0) { %>
            <tr>
              <td colspan="6" class="py-12 text-center text-gray-500">
                No matching tasks found.
              </td>
            </tr>
          <% } else { %>
            <% tasks.forEach(function(t) { %>
              <tr class="task-row hover:bg-white/[0.02] transition-colors group" data-title="<%= t.title.toLowerCase() %>" data-status="<%= t.status %>" data-project="<%= t.project_id %>">
                <td class="py-3.5 px-4 font-medium text-white max-w-xs truncate">
                  <a href="/projects/<%= t.project_id %>" class="hover:text-indigo-400 transition-colors">
                    <%= t.title %>
                  </a>
                </td>
                <td class="py-3.5 px-4">
                  <a href="/projects/<%= t.project_id %>" class="inline-flex items-center space-x-1.5 hover:underline">
                    <span class="w-2.5 h-2.5 rounded-full" style="background-color: <%= t.project_color || '#6366F1' %>"></span>
                    <span><%= t.project_name %></span>
                  </a>
                </td>
                <td class="py-3.5 px-4">
                  <span class="text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded border border-white/10 bg-white/5 text-gray-300">
                    <%= t.status.replace('_', ' ') %>
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <span class="capitalize font-semibold text-[11px] text-gray-300">
                    <%= t.priority %>
                  </span>
                </td>
                <td class="py-3.5 px-4">
                  <% if (t.assignee_name) { %>
                    <div class="flex items-center space-x-2">
                      <img
                        src="<%= t.assignee_avatar || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150' %>"
                        alt="<%= t.assignee_name %>"
                        class="w-5 h-5 rounded-full object-cover border border-white/20"
                      />
                      <span><%= t.assignee_name %></span>
                    </div>
                  <% } else { %>
                    <span class="text-gray-500">Unassigned</span>
                  <% } %>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <button
                    onclick="deleteTask(<%= t.id %>)"
                    class="text-gray-500 hover:text-rose-400 opacity-60 group-hover:opacity-100 transition-opacity p-1"
                    title="Delete task"
                  >
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                  </button>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  function filterTasks() {
    const q = document.getElementById('taskSearchInput').value.toLowerCase();
    const status = document.getElementById('taskStatusFilter').value;
    const project = document.getElementById('taskProjectFilter').value;

    let count = 0;
    document.querySelectorAll('.task-row').forEach(row => {
      const matchTitle = !q || row.getAttribute('data-title').includes(q);
      const matchStatus = status === 'all' || row.getAttribute('data-status') === status;
      const matchProject = project === 'all' || row.getAttribute('data-project') === project;

      if (matchTitle && matchStatus && matchProject) {
        row.style.display = '';
        count++;
      } else {
        row.style.display = 'none';
      }
    });
    document.getElementById('taskCountText').innerText = count;
  }

  async function deleteTask(taskId) {
    if (!confirm('Are you sure you want to delete this task?')) return;
    await fetch('/tasks/' + taskId, { method: 'DELETE' });
    window.location.reload();
  }
</script>

<%- include('../layouts/footer') %>
