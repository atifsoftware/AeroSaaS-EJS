<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — AeroSaaS (EJS)' : 'AeroSaaS — High-Performance Project Engine' %></title>
  
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/app.css">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#0B0F17] text-gray-100 antialiased selection:bg-indigo-500 selection:text-white min-h-screen">
  <div class="flex h-screen bg-[#0B0F17] text-gray-100 overflow-hidden font-sans">
    <!-- Ambient glowing decorative backgrounds -->
    <div class="ambient-glow -top-40 -left-40 w-96 h-96 bg-indigo-600 rounded-full"></div>
    <div class="ambient-glow -bottom-40 right-20 w-96 h-96 bg-emerald-600 rounded-full"></div>

    <!-- Desktop Sidebar -->
    <aside class="hidden md:flex flex-col w-64 glass-panel border-r border-white/5 z-20">
      <!-- Brand / Logo -->
      <div class="h-16 flex items-center px-6 border-b border-white/5 justify-between">
        <a href="/dashboard" class="flex items-center space-x-3 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center shadow-glow-primary group-hover:scale-105 transition-transform">
            <i data-lucide="sparkles" class="w-5 h-5 text-white"></i>
          </div>
          <div>
            <span class="font-bold text-lg tracking-tight bg-gradient-to-r from-white via-gray-200 to-indigo-200 bg-clip-text text-transparent">
              AeroSaaS
            </span>
            <span class="ml-2 text-[10px] font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-400 border border-indigo-500/30">
              EJS
            </span>
          </div>
        </a>
      </div>

      <!-- Workspace Card -->
      <div class="p-4">
        <div class="p-3 rounded-xl bg-white/[0.03] border border-white/5 flex items-center justify-between hover:bg-white/[0.05] transition-colors">
          <div class="flex items-center space-x-3 overflow-hidden">
            <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-sm">
              <%= (typeof workspace !== 'undefined' && workspace.logo) ? workspace.logo : '⚡' %>
            </div>
            <div class="truncate">
              <div class="text-sm font-semibold truncate text-white">
                <%= (typeof workspace !== 'undefined' && workspace.name) ? workspace.name : 'Workspace' %>
              </div>
              <div class="text-xs text-emerald-400 flex items-center space-x-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="capitalize"><%= (typeof workspace !== 'undefined' && workspace.plan) ? workspace.plan : 'Pro' %> Plan</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 px-3 space-y-1 overflow-y-auto">
        <div class="px-3 pb-2 text-[11px] font-semibold text-gray-400 uppercase tracking-wider">
          Workspace
        </div>

        <a href="/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all <%= (typeof currentPath !== 'undefined' && currentPath === '/dashboard') ? 'bg-indigo-600 text-white shadow-glow-primary' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]' %>">
          <i data-lucide="layout-dashboard" class="w-4 h-4 <%= (typeof currentPath !== 'undefined' && currentPath === '/dashboard') ? 'text-white' : 'text-gray-400' %>"></i>
          <span>Dashboard</span>
        </a>

        <a href="/projects" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/projects')) ? 'bg-indigo-600 text-white shadow-glow-primary' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]' %>">
          <i data-lucide="folder-kanban" class="w-4 h-4 <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/projects')) ? 'text-white' : 'text-gray-400' %>"></i>
          <span>Projects</span>
        </a>

        <a href="/tasks" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/tasks')) ? 'bg-indigo-600 text-white shadow-glow-primary' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]' %>">
          <i data-lucide="check-square" class="w-4 h-4 <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/tasks')) ? 'text-white' : 'text-gray-400' %>"></i>
          <span>All Tasks</span>
        </a>

        <a href="/settings/team" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/settings/team')) ? 'bg-indigo-600 text-white shadow-glow-primary' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]' %>">
          <i data-lucide="users" class="w-4 h-4 <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/settings/team')) ? 'text-white' : 'text-gray-400' %>"></i>
          <span>Team & Invites</span>
        </a>

        <a href="/settings/profile" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/settings/profile')) ? 'bg-indigo-600 text-white shadow-glow-primary' : 'text-gray-400 hover:text-white hover:bg-white/[0.04]' %>">
          <i data-lucide="user" class="w-4 h-4 <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/settings/profile')) ? 'text-white' : 'text-gray-400' %>"></i>
          <span>Account Settings</span>
        </a>

        <div class="pt-6 px-3 pb-2 text-[11px] font-semibold text-gray-400 uppercase tracking-wider">
          Developer
        </div>
        <a href="/docs" target="_blank" rel="noreferrer" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-400 hover:text-white hover:bg-white/[0.04] transition-all">
          <i data-lucide="book-open" class="w-4 h-4 text-emerald-400"></i>
          <span>Swagger API Docs</span>
          <span class="ml-auto text-[10px] text-gray-400 bg-white/5 px-1.5 py-0.5 rounded">
            OpenAPI
          </span>
        </a>
      </nav>

      <!-- User footer -->
      <div class="p-4 border-t border-white/5">
        <div class="flex items-center justify-between p-2 rounded-xl bg-white/[0.02] border border-white/5">
          <div class="flex items-center space-x-3 overflow-hidden">
            <img src="<%= (typeof user !== 'undefined' && user.avatar) ? user.avatar : 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150' %>" alt="<%= (typeof user !== 'undefined' && user.name) ? user.name : 'User' %>" class="w-8 h-8 rounded-full border border-indigo-500/30 object-cover">
            <div class="truncate">
              <div class="text-xs font-semibold text-white truncate"><%= (typeof user !== 'undefined' && user.name) ? user.name : 'User' %></div>
              <div class="text-[10px] text-gray-400 truncate"><%= (typeof user !== 'undefined' && user.email) ? user.email : '' %></div>
            </div>
          </div>
          <form action="/logout" method="POST">
            <button type="submit" class="p-1.5 rounded-lg text-gray-400 hover:text-rose-400 hover:bg-rose-500/10 transition-colors" title="Sign Out">
              <i data-lucide="log-out" class="w-4 h-4"></i>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col overflow-hidden relative z-10">
      <!-- Mobile Header -->
      <header class="md:hidden h-14 glass-panel border-b border-white/5 flex items-center justify-between px-4">
        <div class="flex items-center space-x-2">
          <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center">
            <i data-lucide="sparkles" class="w-4 h-4 text-white"></i>
          </div>
          <span class="font-bold text-white text-base">AeroSaaS (EJS)</span>
        </div>
        <a href="/logout" class="p-2 text-gray-400 hover:text-rose-400">
          <i data-lucide="log-out" class="w-5 h-5"></i>
        </a>
      </header>

      <!-- Main viewport -->
      <main class="flex-1 overflow-y-auto p-4 md:p-8">
